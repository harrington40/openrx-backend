# Environment for running the backend against the test database.
#
# Copy to backend/.env.test and point it at the schema created by
# backend/test-db/setup-test-db.sh. This file contains no real secrets.
#
#   cp backend/.env.test.example backend/.env.test
#
# Note: the backend reads process.env at startup and dotenv does not override
# variables that are already set, so CI can simply export these values and skip
# the file entirely. backend/test-db/run-backend-against-test-db.sh does exactly that.

PORT=3202

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=openrx_test
DB_PASSWORD=openrx_test
DB_DATABASE=openrx_test

# Never turn this on outside a throwaway environment: it logs every statement
# with its parameters, including patient names, dates of birth and phone numbers.
DB_LOGGING=false

# Test-only signing secret. Production uses a different value.
JWT_SECRET=openrx-test-secret-do-not-use-in-production
