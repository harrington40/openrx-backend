# Backend configuration. Copy to backend/.env and fill in the values.
#
#   cp backend/.env.example backend/.env
#
# Nothing here has a default in the source. Anything marked REQUIRED stops the
# process at startup when it is missing, which is deliberate: a fallback in the
# source is a value published in this repository.

PORT=3002

# REQUIRED. The database connection.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=openemr
# No default password. An empty value means "no password", which is what a
# throwaway local database has - so leave it blank only when that is true.
DB_PASSWORD=
DB_DATABASE=openemr

# Never enable outside a throwaway environment: it logs every statement with its
# parameters, including patient names, dates of birth and phone numbers.
DB_LOGGING=false

# REQUIRED. HS256 key for access tokens. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# REQUIRED. Licence signing secrets, newest first, `<version>:<secret>` entries
# separated by commas. Keep older versions listed so keys issued under them still
# validate. Generate a new one with `openssl rand -hex 32` and put it in front,
# for example:
#   LICENSE_SECRETS=2:<new secret>,1:<previous secret>
LICENSE_SECRETS=

# REQUIRED. SHA-256 of the sales-side generator passphrase - only the hash is
# configured, never the passphrase itself. Compute it with:
#   printf '%s' 'your passphrase' | sha256sum
LICENSE_GENERATOR_PASSPHRASE_HASH=
