// OpenRx release pipeline — a customer release in one click.
//
//   OpenRx-Release (manual) ──▶ validate ──▶ test gate ──▶ stamp + build
//                              ──▶ package ──▶ notes ──▶ commit + tag + push
//                              ──▶ (optional) deploy
//
// Distinct from the CI/Nightly pipelines: this one is started by hand, is
// versioned (semver tag vX.Y.Z), and produces downloadable release artifacts.
// The version lives in the root VERSION file; tools/release.py stamps it into
// both package.json files and backend/src/config/version.ts (so /config shows it).
//
// Job config (Job → Configure):
//   * SCM: this repo, Script Path: Jenkinsfile.release
//   * a "Username with password" credential id `openrx-github` (a GitHub token
//     with repo write access) so the release can commit the version bump and
//     push the tag.
//   * for DEPLOY: the same DEPLOY_* settings as the CI pipeline.
pipeline {
    agent any

    options {
        // A release must never overlap another release.
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '50', artifactNumToKeepStr: '50'))
        timeout(time: 90, unit: 'MINUTES')
    }

    parameters {
        string(name: 'RELEASE_VERSION', defaultValue: '',
            description: 'Version to release, semver, e.g. 1.4.0 (required).')
        booleanParam(name: 'RUN_TESTS', defaultValue: true,
            description: 'Run the backend unit tests + build as a release gate.')
        booleanParam(name: 'PUSH_TAG', defaultValue: true,
            description: 'Commit the version bump and push the v<version> git tag.')
        booleanParam(name: 'GITHUB_RELEASE', defaultValue: true,
            description: 'Publish a GitHub Release for the tag using RELEASE_NOTES-<version>.md (skipped in DRY_RUN, or when PUSH_TAG=false).')
        booleanParam(name: 'BUILD_FRONTEND', defaultValue: true,
            description: 'Also build and package the SPA (interface/new).')
        booleanParam(name: 'DEPLOY', defaultValue: false,
            description: 'Deploy the released backend after a successful build.')
        booleanParam(name: 'DRY_RUN', defaultValue: false,
            description: 'Do everything except commit/tag/push and deploy.')
        string(name: 'SMOKE_BASE_URL', defaultValue: 'https://openrx.transtechologies.com',
            description: 'Origin to smoke-test after deploy (SPA root + /api).')
        booleanParam(name: 'SMOKE_LOGIN', defaultValue: true,
            description: 'Use the openrx-smoke credential to exercise login + authenticated routes.')
        booleanParam(name: 'SMOKE_ROLLBACK', defaultValue: false,
            description: 'If the post-deploy smoke test fails, roll the backend back one release.')
        string(name: 'NOTIFY_EMAIL', defaultValue: '',
            description: 'Email address to notify on failure (blank = no email). Needs Jenkins SMTP.')
    }

    environment {
        GIT_URL = 'github.com/harrington40/openrx-backend.git'
        GIT_BRANCH = 'main'
        GIT_CREDENTIALS = 'openrx-github'
        GITHUB_REPO = 'harrington40/openrx-backend'
        SMOKE_CREDENTIALS = 'openrx-smoke'
        SMOKE_BASE_URL = "${params.SMOKE_BASE_URL}"
        DEPLOY_SERVER = "${env.DEPLOY_SERVER ?: 'dev@94.250.201.58'}"
        DEPLOY_REMOTE_DIR = "${env.DEPLOY_REMOTE_DIR ?: '/home/dev/openrx'}"
        DEPLOY_SSH_KEY = "${env.DEPLOY_SSH_KEY ?: '/home/dev/.ssh/openrx-deploy'}"
        DEPLOY_KEEP = "${env.DEPLOY_KEEP ?: '3'}"
        // Parameters, exposed to the sh steps as plain env vars.
        RUN_TESTS = "${params.RUN_TESTS}"
        PUSH_TAG = "${params.PUSH_TAG}"
        GITHUB_RELEASE = "${params.GITHUB_RELEASE}"
        BUILD_FRONTEND = "${params.BUILD_FRONTEND}"
        DEPLOY = "${params.DEPLOY}"
        DRY_RUN = "${params.DRY_RUN}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh '''
                    set -e
                    git fetch --tags --force
                    echo "Checked out $(git rev-parse --short HEAD) on $(git branch --show-current)"
                '''
            }
        }

        stage('Validate version') {
            steps {
                script {
                    def version = (params.RELEASE_VERSION ?: '').trim()
                    // A release is versioned, so the version must be explicit. Guard
                    // here rather than relying on a bare `set` expansion, so a missing
                    // value fails with a branded, actionable message instead of a raw
                    // "RELEASE_VERSION: parameter null or not set" shell error.
                    if (!version) {
                        echo '======================================'
                        echo ' OPENRX RELEASE: RELEASE_VERSION is not set'
                        echo '======================================'
                        echo 'This job cuts a versioned customer release and needs an'
                        echo 'explicit semver. Re-run it with "Build with Parameters" and set:'
                        echo '  RELEASE_VERSION = <major.minor.patch>   e.g. 1.4.0'
                        echo 'Tip: set DRY_RUN=true first to rehearse the release.'
                        error('RELEASE_VERSION is required: re-run with "Build with Parameters" and a semver such as 1.4.0')
                    }
                    withEnv(["RELEASE_VERSION=${version}"]) {
                        sh '''
                            set -e
                            python3 tools/release.py check "$RELEASE_VERSION"
                            echo "RELEASE_VERSION=$RELEASE_VERSION"
                        '''
                    }
                }
            }
        }

        stage('Test gate') {
            when { expression { return params.RUN_TESTS } }
            steps {
                dir('backend') {
                    sh '''
                        set -e
                        npm ci
                        echo "Linting..."
                        npx eslint "{src,apps,libs,test}/**/*.ts" || true
                        echo "Backend unit tests (Jest)..."
                        npm test -- --runInBand
                    '''
                }
                sh '''
                    set -e
                    if [ "$BUILD_FRONTEND" = "true" ]; then
                        echo "Frontend unit tests (Vitest)..."
                        cd interface/new
                        npm ci --no-audit --no-fund
                        npm test
                    else
                        echo "Skipping Vitest (BUILD_FRONTEND=false)"
                    fi
                '''
            }
        }

        stage('Stamp version + build backend') {
            steps {
                sh '''
                    set -e
                    python3 tools/release.py set "$RELEASE_VERSION"
                    # Consistency gate: VERSION, both package.json files and
                    # version.ts must all equal RELEASE_VERSION.
                    python3 tools/release.py verify "$RELEASE_VERSION"

                    echo "Building backend..."
                    cd backend
                    npm ci --no-audit --no-fund >/dev/null 2>&1 || true
                    npm run build
                    test -f dist/main.js || { echo "backend build produced no dist/main.js"; exit 1; }
                '''
            }
        }

        stage('Build SPA') {
            when { expression { return params.BUILD_FRONTEND } }
            steps {
                sh '''
                    set -e
                    # vite.config.ts builds into the repo-root public/dist
                    # (outDir: ../../public/dist), which the web server serves.
                    cd interface/new
                    npm ci --no-audit --no-fund
                    npm run build
                    test -f ../../public/dist/index.html \
                        || { echo "SPA build produced no public/dist/index.html"; exit 1; }
                '''
            }
        }

        stage('Assemble unified package') {
            steps {
                sh '''
                    set -e
                    V="$RELEASE_VERSION"
                    PKG="release/openrx-$V"
                    rm -rf "$PKG"
                    mkdir -p "$PKG/backend"

                    # Backend runtime: compiled dist + package metadata. Never node_modules.
                    cp -a backend/dist "$PKG/backend/dist"
                    cp -a backend/package.json backend/package-lock.json "$PKG/backend/"

                    # Frontend: the SPA production build. The backend is API-only,
                    # so the package mirrors production: the SPA lives at the site
                    # root (public/dist) and the web server serves it.
                    if [ -f public/dist/index.html ]; then
                        mkdir -p "$PKG/public"
                        cp -a public/dist "$PKG/public/dist"
                    fi

                    cp VERSION "$PKG/VERSION"
                    python3 tools/release.py notes --version "$V" > "$PKG/RELEASE_NOTES-$V.md"
                    python3 tools/release.py build-info --version "$V" --out "$PKG/BUILD_INFO.json"
                    echo "Assembled:"; find "$PKG" -maxdepth 2 -type d | sort
                '''
            }
        }

        stage('Verify package contents') {
            steps {
                sh '''
                    set -e
                    V="$RELEASE_VERSION"
                    PKG="release/openrx-$V"
                    fail=0
                    need() { [ -f "$1" ] || { echo "MISSING: $1"; fail=1; }; }

                    need "$PKG/backend/dist/main.js"
                    need "$PKG/backend/package.json"
                    need "$PKG/backend/package-lock.json"
                    need "$PKG/VERSION"
                    need "$PKG/BUILD_INFO.json"
                    need "$PKG/RELEASE_NOTES-$V.md"

                    if [ -f "$PKG/public/dist/index.html" ]; then
                        assets=$(grep -oE "/assets/[A-Za-z0-9._/-]+" "$PKG/public/dist/index.html" | sort -u)
                        [ -n "$assets" ] || { echo "index.html references no assets"; fail=1; }
                        for a in $assets; do
                            [ -f "$PKG/public/dist$a" ] || { echo "MISSING asset: $a"; fail=1; }
                        done
                    else
                        echo "NOTE: no SPA in the package (BUILD_FRONTEND=false)"
                    fi

                    [ "$(cat "$PKG/VERSION")" = "$V" ] || { echo "packaged VERSION != $V"; fail=1; }
                    python3 -c "import json;d=json.load(open('$PKG/BUILD_INFO.json'));assert d['version']=='$V',d" \
                        || { echo "BUILD_INFO.json version != $V"; fail=1; }

                    [ "$fail" = 0 ] || { echo "package verification FAILED"; exit 1; }
                    echo "package verification passed"
                '''
            }
        }

        stage('Scan for secrets') {
            steps {
                sh '''
                    set -e
                    PKG="release/openrx-$RELEASE_VERSION"

                    # Known-dangerous files (by name). A legitimate
                    # dist/config/secrets.js exists, so do NOT match on "secret".
                    hits=""
                    for pat in '.env' '.env.*' '*.pem' '*.key' 'id_rsa*' 'id_ed25519*' '*.sql'; do
                        found=$(find "$PKG" -type f -name "$pat" 2>/dev/null || true)
                        [ -n "$found" ] && hits="$hits$found
"
                    done
                    gitdir=$(find "$PKG" -type d -name '.git' 2>/dev/null || true)

                    if [ -n "$(printf '%s' "$hits" | tr -d '[:space:]')" ] || [ -n "$gitdir" ]; then
                        echo "Refusing to package potential secret/config files:"
                        printf '%s\\n' "$hits" "$gitdir"
                        exit 1
                    fi

                    if grep -rInE 'BEGIN (RSA|OPENSSH|PRIVATE) KEY|ghp_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}' "$PKG" 2>/dev/null; then
                        echo "Obvious secret found in the package."; exit 1
                    fi
                    echo "secret scan clean"
                '''
            }
        }

        stage('Package release artifacts') {
            steps {
                sh '''
                    set -e
                    V="$RELEASE_VERSION"

                    # Canonical customer package (backend + SPA + metadata).
                    tar -czf "release/openrx-$V.tar.gz" -C release "openrx-$V"

                    # Split artifacts matching the server deploy.sh contract:
                    #   backend  -> top-level dist/ with main.js
                    #   frontend -> top-level dist/ with index.html
                    tar -czf "release/openrx-backend-$V.tar.gz" -C backend dist
                    if [ -f public/dist/index.html ]; then
                        tar -czf "release/openrx-frontend-$V.tar.gz" -C public dist
                    fi

                    echo "Release artifacts:"; ls -la release

                    listing=$(tar -tzf "release/openrx-$V.tar.gz")
                    for m in "openrx-$V/backend/dist/main.js" "openrx-$V/backend/package.json" \
                             "openrx-$V/backend/package-lock.json" "openrx-$V/VERSION" \
                             "openrx-$V/BUILD_INFO.json" "openrx-$V/RELEASE_NOTES-$V.md"; do
                        echo "$listing" | grep -qx "$m" || { echo "tarball missing: $m"; exit 1; }
                    done
                    if [ -f public/dist/index.html ]; then
                        echo "$listing" | grep -q "openrx-$V/public/dist/index.html" \
                            || { echo "tarball missing the SPA index.html"; exit 1; }
                    fi
                    echo "tarball verification passed"
                '''
            }
        }

        stage('Commit version + tag + push') {
            when { expression { return params.PUSH_TAG && !params.DRY_RUN } }
            steps {
                withCredentials([usernamePassword(credentialsId: env.GIT_CREDENTIALS,
                                                  usernameVariable: 'GIT_USER',
                                                  passwordVariable: 'GIT_TOKEN')]) {
                    sh '''
                        set -e
                        git config user.name  "OpenRx CI"
                        git config user.email "ci@transtechologies.com"

                        git add VERSION backend/package.json interface/new/package.json \
                                backend/src/config/version.ts
                        if git diff --cached --quiet; then
                            echo "No version change to commit"
                        else
                            git commit -m "chore(release): v$RELEASE_VERSION"
                        fi

                        git tag -a "v$RELEASE_VERSION" -m "OpenRx $RELEASE_VERSION" || true
                        git remote set-url origin "https://$GIT_USER:$GIT_TOKEN@$GIT_URL"
                        git push origin "HEAD:$GIT_BRANCH"
                        git push origin "v$RELEASE_VERSION"
                        echo "Released v$RELEASE_VERSION"
                    '''
                }
            }
        }

        // Publish a GitHub Release for the tag, using the same release notes the
        // package contains (release/RELEASE_NOTES-<version>.md). Needs a GitHub
        // token with `repo` scope (the `openrx-github` credential). Skipped in
        // DRY_RUN or when PUSH_TAG=false.
        stage('GitHub release') {
            when { expression { return params.GITHUB_RELEASE && params.PUSH_TAG && !params.DRY_RUN } }
            steps {
                withCredentials([usernamePassword(credentialsId: env.GIT_CREDENTIALS,
                                                  usernameVariable: 'GIT_USER',
                                                  passwordVariable: 'GIT_TOKEN')]) {
                    sh '''
                        set -e
                        export GITHUB_TOKEN="$GIT_TOKEN"
                        python3 tools/release.py github-release \
                            --repo "$GITHUB_REPO" \
                            --tag "v$RELEASE_VERSION" \
                            --name "OpenRx $RELEASE_VERSION" \
                            --notes-file "release/RELEASE_NOTES-$RELEASE_VERSION.md" \
                            --asset "release/openrx-$RELEASE_VERSION.tar.gz" \
                            --asset "release/BUILD_INFO.json"
                    '''
                }
            }
        }

        // Deploys the SAME artifacts the Package stage built — no rebuild here.
        // Uses the server-side deploy.sh contract (separate --backend / --frontend
        // tarballs), which is the existing production safety control.
        stage('Deploy (customer)') {
            when { expression { return params.DEPLOY && !params.DRY_RUN } }
            steps {
                sh '''
                    set -e
                    V="$RELEASE_VERSION"
                    BACKEND_TAR="release/openrx-backend-$V.tar.gz"
                    FRONTEND_TAR="release/openrx-frontend-$V.tar.gz"
                    test -f "$BACKEND_TAR" || { echo "missing $BACKEND_TAR (build the package first)"; exit 1; }

                    SSH_OPTS="-i $DEPLOY_SSH_KEY -o BatchMode=yes -o StrictHostKeyChecking=accept-new"
                    ssh $SSH_OPTS "$DEPLOY_SERVER" "mkdir -p $DEPLOY_REMOTE_DIR/incoming"
                    scp -q $SSH_OPTS "$BACKEND_TAR" "$DEPLOY_SERVER:$DEPLOY_REMOTE_DIR/incoming/"
                    ssh $SSH_OPTS "$DEPLOY_SERVER" \
                        "cd $DEPLOY_REMOTE_DIR && ./deploy.sh --backend incoming/openrx-backend-$V.tar.gz --keep $DEPLOY_KEEP"

                    if [ -f "$FRONTEND_TAR" ]; then
                        scp -q $SSH_OPTS "$FRONTEND_TAR" "$DEPLOY_SERVER:$DEPLOY_REMOTE_DIR/incoming/"
                        ssh $SSH_OPTS "$DEPLOY_SERVER" \
                            "cd $DEPLOY_REMOTE_DIR && ./deploy.sh --frontend incoming/openrx-frontend-$V.tar.gz --keep $DEPLOY_KEEP"
                    else
                        echo "No frontend tarball; deployed the backend only"
                    fi
                    echo "Deployed $V to $DEPLOY_SERVER (backend + frontend from one build)"
                '''
            }
        }

        // POST-DEPLOY SMOKE. A release is not "done" until the running deploy
        // answers: /config (with the released version), the SPA root + a
        // referenced asset, a login, and key read-only routes. Fails the release
        // otherwise; SMOKE_ROLLBACK=true rolls the backend back one release.
        stage('Post-deploy smoke') {
            when { expression { return params.DEPLOY && !params.DRY_RUN } }
            steps {
                script {
                    try {
                        if (params.SMOKE_LOGIN) {
                            withCredentials([usernamePassword(credentialsId: env.SMOKE_CREDENTIALS,
                                                              usernameVariable: 'SMOKE_USER',
                                                              passwordVariable: 'SMOKE_PASS')]) {
                                sh '''
                                    set -e
                                    python3 tools/release.py smoke \
                                        --base-url "$SMOKE_BASE_URL" \
                                        --expected-version "$RELEASE_VERSION" \
                                        --user "$SMOKE_USER" --password "$SMOKE_PASS" \
                                        --route /api/patients \
                                        --route /api/appointments \
                                        --route /api/providers
                                '''
                            }
                        } else {
                            echo "SMOKE_LOGIN=false — checking anonymously only"
                            sh '''
                                set -e
                                python3 tools/release.py smoke \
                                    --base-url "$SMOKE_BASE_URL" \
                                    --expected-version "$RELEASE_VERSION"
                            '''
                        }
                    } catch (err) {
                        echo "POST-DEPLOY SMOKE FAILED for ${params.RELEASE_VERSION}: ${err}"
                        if (params.SMOKE_ROLLBACK) {
                            echo "SMOKE_ROLLBACK=true — rolling the backend back on ${env.DEPLOY_SERVER}"
                            sh '''
                                set -e
                                ssh -i "$DEPLOY_SSH_KEY" -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
                                    "$DEPLOY_SERVER" "cd $DEPLOY_REMOTE_DIR && ./deploy.sh --rollback --backend 1"
                            '''
                        } else {
                            echo "Set SMOKE_ROLLBACK=true to roll back automatically, or run:"
                            echo "  ssh <server> 'cd <dir> && ./deploy.sh --rollback --backend 1'"
                        }
                        throw err
                    }
                }
            }
        }
    }

    post {
        success {
            echo "======================================"
            echo " OPENRX RELEASE ${params.RELEASE_VERSION} SUCCEEDED"
            echo " dry-run=${params.DRY_RUN}  deploy=${params.DEPLOY}"
            echo "======================================"
        }
        failure {
            echo "======================================"
            echo " OPENRX RELEASE ${params.RELEASE_VERSION} FAILED"
            echo "======================================"
            script {
                def to = (params.NOTIFY_EMAIL ?: '').trim()
                if (to) {
                    try {
                        mail(to: to,
                             subject: "OpenRx release ${params.RELEASE_VERSION} FAILED",
                             body: "OpenRx release failed.\n\n" +
                                   "Version: ${params.RELEASE_VERSION}\n" +
                                   "Dry run: ${params.DRY_RUN}   Deploy: ${params.DEPLOY}\n" +
                                   "Build:   ${env.BUILD_URL}")
                    } catch (err) {
                        echo "mail step unavailable (configure SMTP in Jenkins): ${err}"
                    }
                }
            }
        }
        always {
            archiveArtifacts(artifacts: 'release/**', allowEmptyArchive: true, fingerprint: true)
        }
    }
}
