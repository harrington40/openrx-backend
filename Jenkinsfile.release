// OpenRx release pipeline — a customer release in one click.
//
//   OpenRx-Release (manual) ──▶ validate ──▶ test gate ──▶ stamp + build
//                              ──▶ package ──▶ notes ──▶ commit + tag + push
//                              ──▶ (optional) deploy
//
// Distinct from the CI/Nightly pipelines: this one is started by hand, is
// versioned (semver tag vX.Y.Z), and produces downloadable release artifacts.
// The version lives in the root VERSION file; tools/release.py stamps it into
// both package.json files and backend/src/config/version.ts (so /config shows it).
//
// Job config (Job → Configure):
//   * SCM: this repo, Script Path: Jenkinsfile.release
//   * a "Username with password" credential id `openrx-github` (a GitHub token
//     with repo write access) so the release can commit the version bump and
//     push the tag.
//   * for DEPLOY: the same DEPLOY_* settings as the CI pipeline.
pipeline {
    agent any

    options {
        // A release must never overlap another release.
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '50', artifactNumToKeepStr: '50'))
        timeout(time: 90, unit: 'MINUTES')
    }

    parameters {
        string(name: 'RELEASE_VERSION', defaultValue: '',
            description: 'Version to release, semver, e.g. 1.4.0 (required).')
        booleanParam(name: 'RUN_TESTS', defaultValue: true,
            description: 'Run the backend unit tests + build as a release gate.')
        booleanParam(name: 'PUSH_TAG', defaultValue: true,
            description: 'Commit the version bump and push the v<version> git tag.')
        booleanParam(name: 'BUILD_FRONTEND', defaultValue: true,
            description: 'Also build and package the SPA (interface/new).')
        booleanParam(name: 'DEPLOY', defaultValue: false,
            description: 'Deploy the released backend after a successful build.')
        booleanParam(name: 'DRY_RUN', defaultValue: false,
            description: 'Do everything except commit/tag/push and deploy.')
    }

    environment {
        GIT_URL = 'github.com/harrington40/openrx-backend.git'
        GIT_BRANCH = 'main'
        GIT_CREDENTIALS = 'openrx-github'
        DEPLOY_SERVER = "${env.DEPLOY_SERVER ?: 'dev@94.250.201.58'}"
        DEPLOY_REMOTE_DIR = "${env.DEPLOY_REMOTE_DIR ?: '/home/dev/openrx'}"
        DEPLOY_SSH_KEY = "${env.DEPLOY_SSH_KEY ?: '/home/dev/.ssh/openrx-deploy'}"
        DEPLOY_KEEP = "${env.DEPLOY_KEEP ?: '3'}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh '''
                    set -e
                    git fetch --tags --force
                    echo "Checked out $(git rev-parse --short HEAD) on $(git branch --show-current)"
                '''
            }
        }

        stage('Validate version') {
            steps {
                sh '''
                    set -e
                    V="${RELEASE_VERSION:?set RELEASE_VERSION (e.g. 1.4.0)}"
                    python3 tools/release.py check "$V"
                    echo "RELEASE_VERSION=$V"
                '''
            }
        }

        stage('Test gate') {
            when { expression { return params.RUN_TESTS } }
            steps {
                dir('backend') {
                    sh '''
                        set -e
                        npm ci
                        echo "Linting..."
                        npx eslint "{src,apps,libs,test}/**/*.ts" || true
                        echo "Unit tests..."
                        npm test -- --runInBand
                    '''
                }
            }
        }

        stage('Stamp version + build backend') {
            steps {
                sh '''
                    set -e
                    python3 tools/release.py set "$RELEASE_VERSION"
                    echo "Building backend..."
                    cd backend
                    npm ci --no-audit --no-fund >/dev/null 2>&1 || true
                    npm run build
                    test -f dist/main.js
                '''
            }
        }

        stage('Build SPA') {
            when { expression { return params.BUILD_FRONTEND } }
            steps {
                sh '''
                    set -e
                    cd interface/new
                    npm ci --no-audit --no-fund
                    npm run build
                    test -f dist/index.html
                '''
            }
        }

        stage('Package release artifacts') {
            steps {
                sh '''
                    set -e
                    V="$RELEASE_VERSION"
                    mkdir -p release
                    tar -czf "release/openrx-backend-$V.tar.gz" -C backend dist
                    if [ -f interface/new/dist/index.html ]; then
                        tar -czf "release/openrx-frontend-$V.tar.gz" -C interface/new dist
                    fi
                    python3 tools/release.py notes --version "$V" > "release/RELEASE_NOTES-$V.md"
                    cp VERSION "release/VERSION"
                    echo "Release artifacts:"; ls -la release
                '''
            }
        }

        stage('Commit version + tag + push') {
            when { expression { return params.PUSH_TAG && !params.DRY_RUN } }
            steps {
                withCredentials([usernamePassword(credentialsId: env.GIT_CREDENTIALS,
                                                  usernameVariable: 'GIT_USER',
                                                  passwordVariable: 'GIT_TOKEN')]) {
                    sh '''
                        set -e
                        git config user.name  "OpenRx CI"
                        git config user.email "ci@transtechologies.com"

                        git add VERSION backend/package.json interface/new/package.json \
                                backend/src/config/version.ts
                        if git diff --cached --quiet; then
                            echo "No version change to commit"
                        else
                            git commit -m "chore(release): v$RELEASE_VERSION"
                        fi

                        git tag -a "v$RELEASE_VERSION" -m "OpenRx $RELEASE_VERSION" || true
                        git remote set-url origin "https://$GIT_USER:$GIT_TOKEN@$GIT_URL"
                        git push origin "HEAD:$GIT_BRANCH"
                        git push origin "v$RELEASE_VERSION"
                        echo "Released v$RELEASE_VERSION"
                    '''
                }
            }
        }

        stage('Deploy (customer)') {
            when { expression { return params.DEPLOY && !params.DRY_RUN } }
            steps {
                sh '''
                    set -e
                    V="$RELEASE_VERSION"
                    TARBALL="release/openrx-backend-$V.tar.gz"
                    test -f "$TARBALL" || { echo "missing $TARBALL"; exit 1; }

                    SSH_OPTS="-i $DEPLOY_SSH_KEY -o BatchMode=yes -o StrictHostKeyChecking=accept-new"
                    ssh $SSH_OPTS "$DEPLOY_SERVER" "mkdir -p $DEPLOY_REMOTE_DIR/incoming"
                    scp -q $SSH_OPTS "$TARBALL" "$DEPLOY_SERVER:$DEPLOY_REMOTE_DIR/incoming/"
                    ssh $SSH_OPTS "$DEPLOY_SERVER" \
                        "cd $DEPLOY_REMOTE_DIR && ./deploy.sh --backend incoming/openrx-backend-$V.tar.gz --keep $DEPLOY_KEEP"
                    echo "Deployed $V to $DEPLOY_SERVER"
                '''
            }
        }
    }

    post {
        success {
            echo "======================================"
            echo " OPENRX RELEASE ${params.RELEASE_VERSION} SUCCEEDED"
            echo " dry-run=${params.DRY_RUN}  deploy=${params.DEPLOY}"
            echo "======================================"
        }
        failure {
            echo "======================================"
            echo " OPENRX RELEASE ${params.RELEASE_VERSION} FAILED"
            echo "======================================"
        }
        always {
            archiveArtifacts(artifacts: 'release/**', allowEmptyArchive: true, fingerprint: true)
        }
    }
}
